# =============================================================================
# STREAMX — environment configuration (CONTRACTS.md §12)
#
# Copy to `.env` and adjust. Every variable is prefixed STREAMX_.
# The Go binaries read these directly; docker-compose.yml sets them per
# service. `make dev` uses the same names.
# =============================================================================

# ---------------------------------------------------------------------------
# Brokers (one set per broker process: broker-1, broker-2, broker-3)
# ---------------------------------------------------------------------------

# Unique broker id (also used for deterministic leader election: lowest live
# id wins).
STREAMX_BROKER_ID=broker-1

# Data-plane listen address (TCP).
STREAMX_BROKER_ADDR=:9092

# Metrics/health listen address (Prometheus /metrics + /healthz).
STREAMX_METRICS_ADDR=:9102

# Cluster membership: comma-separated id=host:port pairs. Every broker gets
# the SAME value.
STREAMX_CLUSTER=broker-1=127.0.0.1:9092,broker-2=127.0.0.1:9093,broker-3=127.0.0.1:9094

# Where segment logs are written.
STREAMX_DATA_DIR=./data/broker-1

# Fsync policy: 0 = fsync every append batch (default); >0 = batched every N
# ms; -1 = never (benchmark mode — data loss risk on crash).
STREAMX_FSYNC_INTERVAL_MS=0

# Segment roll size in bytes (default 64 MiB).
STREAMX_SEGMENT_MAX_BYTES=67108864

# Retention sweep interval in ms (default 30 s).
STREAMX_RETENTION_CHECK_INTERVAL_MS=30000

# Gossip heartbeat interval in ms (default 500 ms).
STREAMX_HEARTBEAT_INTERVAL_MS=500

# A broker is declared dead after this many ms without a heartbeat
# (default 1500 ms = 3 missed heartbeats).
STREAMX_BROKER_TIMEOUT_MS=1500

# Producer rate limit: events/sec per producer_id (token bucket).
STREAMX_PRODUCE_RATE_LIMIT=50000

# Topic rate limit: events/sec per topic (token bucket).
STREAMX_TOPIC_RATE_LIMIT=200000

# Max produce batch size in bytes (default 16 MiB).
STREAMX_MAX_BATCH_BYTES=16777216

# Per-partition pending-append backpressure budget in bytes (default 64 MiB).
STREAMX_PENDING_APPEND_BUDGET=67108864

# ---------------------------------------------------------------------------
# API (control plane)
# ---------------------------------------------------------------------------

# REST/SSE listen address.
STREAMX_API_ADDR=:8080

# Metadata store. PostgreSQL is the production store; SQLite is a first-class
# dev fallback.
#   postgres://user:pass@host:5432/db
#   sqlite://./data/streamx.db
STREAMX_DB_URL=postgres://streamx:streamx@localhost:5432/streamx

# Bootstrap users (created on first run if absent). Dev credentials — change
# in production.
STREAMX_ADMIN_USER=admin
STREAMX_ADMIN_PASSWORD=admin123
STREAMX_OPERATOR_USER=operator
STREAMX_OPERATOR_PASSWORD=operator123

# API rate limit: requests/sec per token (token bucket).
STREAMX_RATE_LIMIT_RPS=500

# Redis URL for the rate limiter. Empty = in-memory fallback.
STREAMX_REDIS_URL=

# Broker cluster as seen by the API (same format as STREAMX_CLUSTER).
STREAMX_BROKER_CLUSTER=broker-1=127.0.0.1:9092,broker-2=127.0.0.1:9093,broker-3=127.0.0.1:9094

# ---------------------------------------------------------------------------
# Worker (consumer-group client)
# ---------------------------------------------------------------------------

# Consumer group name.
STREAMX_WORKER_GROUP=orders-group

# Topic to consume.
STREAMX_WORKER_TOPIC=orders

# Handler: noop | log | fail:<p> | slow:<ms>
#   fail:0.15  → 15% of events fail (exercises retry + DLQ)
#   slow:200   → add 200 ms of handler latency (builds lag)
STREAMX_WORKER_HANDLER=log

# In-place retries before an event goes to the DLQ.
STREAMX_WORKER_MAX_RETRIES=3

# Handler concurrency per consumer.
STREAMX_WORKER_CONCURRENCY=8

# Stable member id (default: random m-<rand>).
STREAMX_WORKER_MEMBER_ID=

# ---------------------------------------------------------------------------
# Bench (load generator)
# ---------------------------------------------------------------------------

# Control-plane URL the bench registers/runs against.
STREAMX_BENCH_API=http://localhost:8080

# Bearer token for the bench (obtain via POST /api/v1/auth/login).
STREAMX_BENCH_TOKEN=

# ---------------------------------------------------------------------------
# Web (dashboard)
# ---------------------------------------------------------------------------

# Control-plane base URL for the browser (CONTRACTS.md §12 uses this exact
# name, unprefixed). In dev the Next.js server rewrites /api/* to
# http://localhost:8080, so this can stay empty (same origin).
NEXT_PUBLIC_API_URL=http://localhost:8080