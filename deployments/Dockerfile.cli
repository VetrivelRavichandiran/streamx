# STREAMX CLI — operator tool (cmd/streamx)
# One-shot command tool; not a long-running server, so no HEALTHCHECK.
FROM golang:1.25 AS build
WORKDIR /src
# go.mod may declare a newer toolchain; let the Go toolchain manager fetch it.
ENV GOTOOLCHAIN=auto
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/streamx ./cmd/streamx

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/streamx /usr/local/bin/streamx
USER nonroot
ENTRYPOINT ["/usr/local/bin/streamx"]