# STREAMX worker — consumer-group client (cmd/worker)
# Long-running consumer process; not an HTTP server, so no HEALTHCHECK.
FROM golang:1.25 AS build
WORKDIR /src
# go.mod may declare a newer toolchain; let the Go toolchain manager fetch it.
ENV GOTOOLCHAIN=auto
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/streamx-worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/streamx-worker /usr/local/bin/streamx-worker
USER nonroot
# Config via env: WORKER_GROUP, WORKER_TOPIC, WORKER_HANDLER, ...
ENTRYPOINT ["/usr/local/bin/streamx-worker"]